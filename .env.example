# Frontend origin allowed by FastAPI CORS. Use the deployed frontend URL in production.
FRONTEND_ORIGIN=http://localhost:3000

# Optional SQLite location for local scan history.
SECURESCAN_DB_PATH=./data/securescan.db

# Optional safety tuning. Keep conservative values in public deployments.
SCAN_TIMEOUT_SECONDS=8
SCAN_MAX_RESPONSE_BYTES=262144
SCAN_MAX_REDIRECTS=3
SCAN_RATE_LIMIT=8
